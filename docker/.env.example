# Copiar a docker/.env (que no se versiona) y llenar. Generar cada secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# secreto del HMAC de las llaves; si cambia, todas las llaves dejan de valer
TERRANOVA_PIMIENTA=
# llave de servicio entre la puerta y los conectores (ADR-0002)
TERRANOVA_CONECTOR_LLAVE=
# dominio público para TLS automático; vacío = HTTP local en 127.0.0.1:8180
TERRANOVA_DOMINIO=
# Opcional (F7.1): un webhook que recibe por POST los canarios rojos. Vacío = no avisa.
TERRANOVA_ALERTA_URL=
# Solo con --profile observabilidad (F7.2): contraseña del admin de Grafana.
GRAFANA_PASSWORD=
# F7.3: carpeta del host donde el servicio `respaldo` deja el pg_dump diario (14 días). Debe
# copiarse fuera de la VM (rclone, borg…): una copia en la misma máquina no es un respaldo.
TERRANOVA_RESPALDOS=./respaldos
