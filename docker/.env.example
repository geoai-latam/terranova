# Copiar a docker/.env (que no se versiona) y llenar. Generar cada secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# secreto del HMAC de las llaves; si cambia, todas las llaves dejan de valer
TERRANOVA_PIMIENTA=
# llave de servicio entre la puerta y los conectores (ADR-0002)
TERRANOVA_CONECTOR_LLAVE=
# dominio público para TLS automático; vacío = HTTP local en 127.0.0.1:8180
TERRANOVA_DOMINIO=
