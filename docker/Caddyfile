# Caddy: TLS automático con un dominio (TERRANOVA_DOMINIO=api.ejemplo.org); en local, HTTP en :80.
{$TERRANOVA_DOMINIO}

encode zstd gzip

# /metrics es de la red interna (Prometheus lee cada réplica directo): no sale por el borde
respond /metrics 404

# las réplicas de la puerta (TERRANOVA_REPLICAS; en la VPS única de ADR-0030, solo puerta-a)
reverse_proxy {$TERRANOVA_REPLICAS} {
	lb_policy least_conn
	health_uri /v1/fuentes
	health_interval 10s
	# MCP por streamable HTTP: respuestas largas y flujos
	flush_interval -1
	transport http {
		read_timeout 5m
	}
}

header {
	-Server
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
}
